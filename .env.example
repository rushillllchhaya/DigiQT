# NVIDIA NIM API Configuration
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Active flagship models: "nvidia/nemotron-3-ultra-550b-a55b", "mistralai/mistral-large-4-1t-a52b", "nvidia/nemotron-3.5-lightning-30b-a3b", "google/gemma-4-31b-it"
NVIDIA_MODEL_NAME=nvidia/nemotron-3-ultra-550b-a55b

# Optional: Tavily Search API (If not provided, automatically falls back to DuckDuckGo)
TAVILY_API_KEY=your_tavily_api_key_here

# Local Data Paths
POLICY_PDF_PATH=./data/optima-secure-revision-pw.pdf
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
